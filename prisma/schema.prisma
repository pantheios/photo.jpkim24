// bebememo 대체 — 가족 사진 공유 서비스
// 자세한 내용: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 연동된 iCloud 공유앨범 (공개 웹사이트 링크의 토큰)
model AlbumSource {
  id         String    @id @default(cuid())
  token      String    @unique
  name       String?
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
}

// 맥 동기화 에이전트(osxphotos) 인증 토큰
model IngestToken {
  id         String    @id @default(cuid())
  token      String    @unique
  name       String // 예: "아빠 맥북"
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

// 가족 구성원
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("member") // "admin" | "member"
  avatarUrl    String?
  createdAt    DateTime @default(now())

  posts       Post[]
  comments    Comment[]
  reactions   Reaction[]
  invitesSent Invite[]  @relation("InviteCreator")
  inviteUsed  Invite?   @relation("InviteUser")
  devices     DeviceLogin[]
}

// 기기 자동 로그인 — 관리자가 발급한 링크를 폰에서 한 번 열면 그 기기는 이 계정으로 계속 로그인됨
// (비밀번호 입력이 어려운 가족용. 토큰은 기기 쿠키에 저장되고 세션 만료 시 자동 재발급)
model DeviceLogin {
  id         String    @id @default(cuid())
  token      String    @unique
  name       String // 예: "할머니 폰"
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

// 초대코드 — 관리자가 발급, 가입 시 1회 사용
model Invite {
  id          String    @id @default(cuid())
  code        String    @unique
  createdById String
  createdBy   User      @relation("InviteCreator", fields: [createdById], references: [id])
  usedById    String?   @unique
  usedBy      User?     @relation("InviteUser", fields: [usedById], references: [id])
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

// 기기 로그인 요청 (페어링) — 로그인 화면에서 요청 → 관리자가 확인번호 보고 계정 지정·승인
// 승인되면 같은 token으로 DeviceLogin이 만들어지고, 요청한 브라우저만(쿠키로) 그 토큰을 받아간다
model DeviceRequest {
  id        String   @id @default(cuid())
  token     String   @unique // 요청한 브라우저의 대기 쿠키 값 = 승인 후 기기 토큰
  code      String // 4자리 확인번호 (사람이 맞는 기기인지 대조용)
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 아기 프로필 — 생일 기준으로 "생후 N일" 자동 표시
model Child {
  id        String   @id @default(cuid())
  name      String
  birthDate DateTime
  avatarUrl String?
  createdAt DateTime @default(now())

  media MediaChild[]
}

// 사진 묶음 글 (한 글에 여러 장)
model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption   String?
  takenAt   DateTime @default(now()) // 촬영일 (EXIF 또는 업로드 시각)
  source    String   @default("upload") // "upload" | "icloud"
  syncKey   String?  @unique // iCloud 동기화: "<sourceId>:<yyyy-mm-dd>" (촬영일별 묶음)
  createdAt DateTime @default(now())

  media     Media[]
  comments  Comment[]
  reactions Reaction[]

  @@index([takenAt])
}

// 개별 사진/동영상 파일
model Media {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      String   @default("image") // "image" | "video"
  path      String // 원본 상대경로 (uploads/...)
  thumbPath String? // 썸네일 상대경로
  width      Int?
  height     Int?
  order      Int       @default(0)
  takenAt    DateTime? // 개별 촬영시각 (게시물 내 정렬용)
  externalId String?   @unique // 외부 시스템 ID — 사진 라이브러리 UUID / 공유앨범 photoGuid (중복 임포트 방지)
  meta       String?   // 상세정보 JSON (카메라·렌즈·촬영설정·위치 등; osxphotos에서 추출)
  createdAt  DateTime  @default(now())

  children MediaChild[]

  @@index([postId])
}

// 사진에 찍힌 아이 (osxphotos 인물 인식 기반) — 아이별 사진 필터링용
model MediaChild {
  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@id([mediaId, childId])
  @@index([childId])
}

// 댓글
model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([postId])
}

// 이모지 반응 (사용자당 이모지 1개)
model Reaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId])
}
